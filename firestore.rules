rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isAdmin() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Wanachama: kitambulisho chao ni NAMBA YA SIMU (siyo password).
    // Ili "Ingia" ifanye kazi (kutafuta akaunti kwa namba), kila
    // mwanachama aliyesajiliwa anaruhusiwa kusoma orodha ya wanachama
    // wengine (majina + hali ya online). Hakuna taarifa nyeti (bank, n.k)
    // huwekwa hapa, hivyo hii ni sawa kwa biashara ndogo/familia.
    match /users/{phone} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && !exists(/databases/$(database)/documents/users/$(phone));
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /posts/{postId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /products/{productId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      allow create: if isSignedIn();
      allow read, update: if isAdmin();
    }

    // Family chat (kikundi kimoja cha pamoja)
    match /familyChat/{msgId} {
      allow read, create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Maombi ya urafiki (kabla ya kuchat faragha)
    match /friendRequests/{reqId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Chat za faragha kati ya wanachama wawili
    match /privateChats/{chatId} {
      allow read, write: if isSignedIn();
      match /messages/{msgId} {
        allow read, create: if isSignedIn();
      }
    }

    // Hati ya kutambua akaunti za admin
    match /admins/{uid} {
      allow read: if isSignedIn();
      allow write: if false;
    }
  }
}
